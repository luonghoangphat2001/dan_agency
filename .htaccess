# ─── CORS Preflight Fix for cPanel / Apache + Passenger ─────────────────────
# Apache (cPanel) intercepts OPTIONS preflight requests before forwarding to
# Passenger / Node.js, so the Express CORS middleware never runs on preflight.
# This block injects the required CORS headers directly at the Apache layer
# so the browser receives a valid 204 response for OPTIONS without hitting Node.

<IfModule mod_headers.c>
    # Reflect the request Origin back only if it is in the allowed list.
    # This supports multiple allowed origins without exposing a wildcard.
    SetEnvIf Origin "^https://(ai|openclaw|api)\.hpdev\.name\.vn$" CORS_ORIGIN=$0
    SetEnvIf Origin "^http://localhost:(5173|5174|3000)$" CORS_ORIGIN=$0

    Header always set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-API-Key"
    Header always set Access-Control-Max-Age "3600"
    Header always set Vary "Origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Return HTTP 204 immediately for OPTIONS preflight — Apache handles it,
    # no need to pass it to Node.js (which would also work, but adds latency).
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ - [R=204,L]
</IfModule>


